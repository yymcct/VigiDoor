# 华为云 Access Key 和 Secret Key
# 获取方式: 华为云控制台 -> 我的凭证 -> 访问密钥
CLOUD_SDK_AK=
CLOUD_SDK_SK=

# 华为云项目配置
# 获取方式: 华为云控制台 -> 我的凭证 -> API凭证
HUAWEI_PROJECT_ID=
HUAWEI_REGION=

# IoTDA 服务端点（应用侧 HTTPS 地址）
# 标准版格式: https://iotda.{region}.myhuaweicloud.com
# 企业版格式: https://{instance_id}.iotda.{region}.myhuaweicloud.com
IOTDA_ENDPOINT=

# 推流配置（手动调用 /api/v1/stream/start 时使用的 URL 模板）
# {device_id} 会被自动替换为实际的设备ID
RTMP_URL_TEMPLATE=rtmp://zlm-server:1935/live/{device_id}

# ZLMediaKit 服务配置（用于 Webhook 按需推流）
# ZLM_SERVER: ZLM 服务主机名或 IP（容器名 or 宿主机 IP）
# ZLM_RTMP_PORT: ZLM RTMP 端口，默认 1935
ZLM_SERVER=zlm-server
ZLM_RTMP_PORT=1935

# 服务端口
PORT=5002

# TODO 为返回给其他应用访问的ws地址
WS_URL=ws://192.168.38.166:5002
