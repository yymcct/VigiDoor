CLOUD_SDK_SK=tKzRRfYzcGN3WxbgJkRbvulUHsEhu3w1JMI9vSkz

# 华为云项目配置
# 获取方式: 华为云控制台 -> 我的凭证 -> API凭证
HUAWEI_PROJECT_ID=ffb9229f0f5942f8a41580da077568a4
HUAWEI_REGION=cn-north-4

# IoTDA 服务端点（应用侧 HTTPS 地址）
# 标准版格式: https://iotda.{region}.myhuaweicloud.com
# 企业版格式: https://{instance_id}.iotda.{region}.myhuaweicloud.com
IOTDA_ENDPOINT=https://bf0f7e134a.st1.iotda-app.cn-north-4.myhuaweicloud.com

# 推流配置
# {device_id} 会被自动替换为实际的设备ID
RTMP_URL_TEMPLATE=rtmp://zlm-server:1935/live/{device_id}

# 服务端口
PORT=5002